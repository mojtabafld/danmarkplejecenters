{
  "name": "plejecenter-kort",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive map of plejecentre (care homes) across Greater Copenhagen, on OpenStreetMap data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.mjs",
    "build:harness": "node verification/build-harness.mjs",
    "verify": "./verify.sh"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
