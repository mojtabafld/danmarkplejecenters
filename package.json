{
  "name": "plejecenter-kort",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive map of plejecentre (care homes) across Greater Copenhagen, on OpenStreetMap data.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.admin.config.ts",
    "start": "node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/api.test.mjs",
    "serve:memdb": "node tests/serve-with-memdb.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:harness": "node verification/build-harness.mjs",
    "verify": "./verify.sh",
    "build:admin": "vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
