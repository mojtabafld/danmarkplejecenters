node_modules/
dist/

# Generated by `npm run build:harness` — rebuilt by ./verify.sh on every run.
verification/*.html
verification/*.css

# Screenshots the browser harnesses write into the working tree. They are
# evidence for one run, not source, and `git add -A` swept three of them into
# a commit before this line existed.
*.png
!public/**/*.png

# What a server checkout holds beside the code. Never tracked: .env carries the
# database and mail passwords, and the dist.* directories are the deploy's
# staging, previous and failed builds (see scripts/remote-deploy.sh).
.env
dist.next/
dist.prev/
dist.failed/
